    "vuestic-ui": "^1.10.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@trevorism/cypress-test-result-events": "^1.0.0",
    "@trevorism/ui-auth": "^1.2.0",
    "@trevorism/ui-header-bar": "^6.2.0",
    "@trevorism/vitest-test-result-events": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.1",
    "axios": "^1.20.0",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vue-cli-plugin-vuestic-ui": "~1.0.11"
