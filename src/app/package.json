{
  "name": "app",
  "version": "1.0.0",
  "description": "Trevorism Home",
  "author": "trevorism <tbrooks@trevorism.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path",
    "accept": "vitest run",
